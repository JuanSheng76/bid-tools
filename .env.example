# 标策台 环境变量配置
# 复制此文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到 git）

# LLM 大模型配置（招标文件解析功能需要）
# 默认使用 DeepSeek，也支持 OpenAI 兼容接口
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_CHARS=50000

# 会话密钥（生产环境请修改为随机字符串）
# SECRET_KEY=change-me-to-a-random-string

# 演示模式（可选，设为 1 启用演示数据自动填充）
# DEMO_MODE=0
# 禁用定时爬虫（可选，云部署时设为 1）
# DISABLE_SCHEDULER=0
